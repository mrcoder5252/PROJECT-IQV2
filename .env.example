# Project-IQ environment template. Copy to .env and fill in. NEVER commit .env.
# Canonical prefix is PROJECTIQ_ (the legacy PROJECT_IQ_ prefix is still read).

# Google Gemini API key (optional: without it the local rule-based synthesiser is used)
GEMINI_API_KEY=

# Admin portal passkey. Leave empty and the admin portal stays locked.
PROJECTIQ_ADMIN_PASSKEY=

PROJECTIQ_EMBEDDING_MODEL=all-MiniLM-L6-v2
PROJECTIQ_LLM_MODEL=gemini-2.5-flash
PROJECTIQ_LOG_LEVEL=INFO

# Chunking
PROJECTIQ_CHUNK_SIZE=450
PROJECTIQ_CHUNK_OVERLAP=80
PROJECTIQ_HARD_MAX_TOKENS=520

# Originality thresholds (cosine similarity, 0-1). Not yet calibrated on labelled pairs.
PROJECTIQ_DUPLICATE_THRESHOLD=0.82
PROJECTIQ_MODERATE_THRESHOLD=0.65
PROJECTIQ_MIN_RELEVANCE=0.20

STREAMLIT_SERVER_PORT=8501
